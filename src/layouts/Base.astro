---
import '../styles/theme.css';
import Icon from '../components/Icon.astro';
import { t, base, UI } from '../i18n/ui.js';
import Flag from '../components/Flag.astro';
import { brandVars } from '../lib/brand.js';
import { pathFor } from '../lib/shops.js';
const { shop, lang = 'nl', langs = ['nl'] } = Astro.props;
// URL prefix for THIS shop + language; every internal link hangs off it.
const B = pathFor(shop.slug, lang);
const T = t(lang);
const a = shop.address;
const book = shop.booking || `${B}/boeken`;
const bookAttrs = shop.booking ? { target: '_blank', rel: 'noopener' } : {};
const tel = shop.phone ? `tel:${shop.phone.replace(/\s/g, '')}` : null;

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${site}${Astro.url.pathname}`;
// Every language version of this page, for hreflang. The path after the language
// prefix is the same on both, so we can derive siblings from the current URL.
// Same page in every language: strip the shop+lang prefix, keep the tail.
const tail = Astro.url.pathname.replace(new RegExp(`^${B}`), '') || '/';
const deHref = `${pathFor(shop.slug, 'de')}${tail === '/' ? '/' : tail}`;
const alternates = langs.map((l) => ({ lang: l, href: `${site}${pathFor(shop.slug, l)}${tail === '/' ? '/' : tail}` }));
const title = `${shop.name} — ${shop.tagline}`;

// priceRange and opening hours are derived, not hand-maintained — they can't
// drift out of sync with the price list and hours shown on the page.
const prices = shop.services.map((s) => Number(s.price));
const priceRange = `€${Math.min(...prices)}–€${Math.max(...prices)}`;

// Keyed by POSITION, not by day name — hours[] is Monday-first by convention and
// the names are translated, so DAY['Montag'] would be undefined on /de/.
// Likewise "closed" is detected by the absence of a clock, not by the word.
const DAY = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const openingHours = shop.hours
  .map((h, i) => ({ ...h, dow: DAY[i] }))
  .filter((h) => /\d{1,2}:\d{2}/.test(h.time))
  .map((h) => {
    const [open, close] = h.time.split(/\s*[–-]\s*/);
    return { '@type': 'OpeningHoursSpecification', dayOfWeek: h.dow, opens: open, closes: close };
  });

// Root-relative, not bare anchors — this nav also renders on /boeken, where a
// bare '#prijzen' would resolve to /boeken#prijzen and silently do nothing.
// The language prefix keeps you inside the version you're reading.
// #reviews is dropped when the shop has none — the section isn't rendered, so
// linking to it would be a dead anchor.
const links = [
  { href: `${B}/#prijzen`, label: T.navPrices, icon: 'tag' },
  { href: `${B}/boeken`, label: T.navBook, icon: 'calendar' },
  { href: `${B}/#werk`, label: T.navWork, icon: 'image' },
  ...(shop.reviews?.length ? [{ href: `${B}/#reviews`, label: T.navReviews, icon: 'spark' }] : []),
  { href: `${B}/#bezoek`, label: T.navVisit, icon: 'pin' },
];
---
<!doctype html>
<html lang={T.htmlLang} style={brandVars(shop) || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- DEMO ONLY. Remove once signed and moved to the client's own domain. -->
    <meta name="robots" content="noindex, nofollow" />

    <title>{title}</title>
    <meta name="description" content={shop.intro} />
    <meta name="theme-color" content="#f1f0ec" />
    <link rel="canonical" href={pageUrl} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    {alternates.length > 1 && (
      <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    )}

    <!-- Open Graph: without these, sharing the link in WhatsApp shows a blank
         box. For a business that lives in WhatsApp, that's the whole preview. -->
    <meta property="og:type" content="business.business" />
    <meta property="og:site_name" content={shop.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shop.intro} />
    <meta property="og:image" content={shop.hero} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={T.locale.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={shop.intro} />
    <meta name="twitter:image" content={shop.hero} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>document.documentElement.classList.add('js');</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- LocalBusiness: this is what Google reads for the local pack. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'HairSalon',
      '@id': `${site}/#business`,
      name: shop.name,
      description: shop.intro,
      url: site || undefined,
      telephone: shop.phone || undefined,
      image: [shop.hero, shop.storefront].filter(Boolean),
      priceRange,
      currenciesAccepted: 'EUR',
      paymentAccepted: 'Cash, Debit Card',
      address: {
        '@type': 'PostalAddress',
        streetAddress: a.street || undefined,
        postalCode: a.postcode || undefined,
        addressLocality: a.city,
        addressCountry: 'NL',
      },
      // omitted unless real coordinates are filled in — a guessed lat/lng puts
      // the shop on the wrong corner in Maps
      geo: shop.geo?.lat && shop.geo?.lng
        ? { '@type': 'GeoCoordinates', latitude: shop.geo.lat, longitude: shop.geo.lng }
        : undefined,
      hasMap: a.maps || undefined,
      openingHoursSpecification: openingHours,
      makesOffer: shop.services.map((s) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: s.name },
        price: s.price,
        priceCurrency: 'EUR',
      })),
      aggregateRating: shop.rating?.count ? {
        '@type': 'AggregateRating',
        ratingValue: shop.rating.score,
        reviewCount: shop.rating.count,
      } : undefined,
    })} />

    <!-- FAQPage: eligible for the expandable Q&A block in Google results -->
    {shop.faq?.length && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: shop.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })} />
    )}
  </head>

  <body>
    <!-- ============================== NAV ============================== -->
    <header class={`nav${tel ? "" : " no-tel"}${langs.length > 1 ? " has-lang" : ""}`} id="nav">
      <div class="nav-in">
        <!-- Badge AND wordmark, not badge instead of it. These logos are detailed
             emblems with the shop name set inside them, which is illegible at nav
             size — on its own it reads as a smudge and the nav names nothing. The
             badge carries recognition, the type carries the name. alt="" because
             the name is already right there as text. -->
        <a class="mark" href={`${B}/#top`}>
          {shop.logo && <img src={shop.logo} alt="" height="42" />}
          <span>{shop.name}</span>
        </a>

        <nav class="nav-links">
          {links.map((l) => (
            <a href={l.href}>
              <Icon name={l.icon} size={15} stroke={1.9} />
              <span>{l.label}</span>
            </a>
          ))}
        </nav>

        {/* Grouped so space-between pushes the whole cluster right rather than
             spreading the actions apart from each other. Flag sits first — it's a
             quieter control than the booking CTA and shouldn't split it from the
             phone button. */}
        <span class="nav-actions">
          {/* Shows the language you're CURRENTLY on, and clicking switches. With
               only two languages that's unambiguous, and it means the header and
               the footer toggle always agree — showing the German flag on a Dutch
               page read as a mistake. The label says where the click goes. */}
          {langs.length > 1 && (
            <a class="nav-lang" hreflang={langs.find((l) => l !== lang)}
               href={`${pathFor(shop.slug, langs.find((l) => l !== lang))}/`}
               aria-label={UI[langs.find((l) => l !== lang)].langSuggestCta}
               title={UI[langs.find((l) => l !== lang)].langSuggestCta}>
              <Flag code={lang} size={18} />
            </a>
          )}

          <a class="btn btn-sm nav-cta" href={book} {...bookAttrs}>
            <Icon name="calendar" size={15} stroke={1.9} />
            {T.navAppt}
          </a>

          {/* below 940px the pill would otherwise hold only the wordmark */}
          {tel && (
            <a class="btn btn-sm nav-tel" href={tel} aria-label={T.callAria}>
              <Icon name="phone" size={16} stroke={1.9} />
            </a>
          )}
        </span>
      </div>
    </header>

    <slot />

    <!-- Sticky mobile action bar — this traffic is overwhelmingly thumbs. -->
    <nav class="dock">
      {tel && <a href={tel}><Icon name="phone" size={17} /><span>{T.dockCall}</span></a>}
      {a.maps && <a href={a.maps} target="_blank" rel="noopener"><Icon name="pin" size={17} /><span>{T.dockRoute}</span></a>}
      <a class="dock-cta" href={book} {...bookAttrs}><Icon name="calendar" size={17} /><span>{T.navAppt}</span></a>
    </nav>

    <style>
      /* Right-hand cluster: tight gap between the actions, while space-between
         still pushes the group away from the wordmark. */
      .nav-actions { display: flex; align-items: center; gap: 8px; flex: none; }

      /* ---------- language flag ---------- */
      .nav-lang {
        flex: none; display: grid; place-items: center;
        width: 38px; height: 38px; border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.1);
        transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out),
                    transform 0.2s var(--ease-out);
      }
      .nav-lang:hover { background: rgba(255, 255, 255, 0.2); transform: translateY(-1px); }
      .nav.stuck .nav-lang {
        border-color: var(--line);
        background: var(--surface);
        box-shadow: inset 0 1px 0 #fff, var(--sh-1);
      }
      .nav.stuck .nav-lang:hover { box-shadow: inset 0 1px 0 #fff, var(--sh-2); }

      /* ---------- nav ---------- */
      .nav {
        position: fixed;
        top: 0; left: 0; right: 0;
        z-index: 80;
        padding: 16px var(--gut);
        transition: padding 0.4s var(--ease-out);
      }
      .nav-in {
        max-width: var(--max);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 10px 10px 20px;
        border: 1px solid transparent;
        border-radius: 100px;
        /* backdrop-filter was in this list. Animating it means recomputing a
           30px blur every frame for 400ms, on the one element permanently on
           top of the page — the single most expensive thing here. It snaps
           instead; nobody can see a blur ramp behind an opacity fade anyway. */
        transition: background 0.4s var(--ease-out), border-color 0.4s var(--ease-out),
                    box-shadow 0.4s var(--ease-out);
      }

      /* scrolled: condense into a floating pill */
      .nav.stuck { padding-top: 10px; }
      .nav.stuck .nav-in {
        /* Fixing ghosting with opacity was the wrong lever: 0.94 white is a
           solid bar, so the blur was invisible and content hard-cut at the
           pill edge. Ghosting is a function of blur RADIUS, not density —
           at 30px a 5rem heading stops being letterforms and becomes a wash.
           So: much bigger radius, and the density comes back down to where
           the glass actually reads as glass. */
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: saturate(180%) blur(30px);
        border-color: var(--line);
        box-shadow: inset 0 1px 0 #fff, var(--sh-2);
      }

      .mark {
        font-weight: 640;
        letter-spacing: -0.035em;
        font-size: 0.98rem;
        color: #fff;
        text-decoration: none;
        transition: color 0.4s var(--ease-out);
      }
      .nav.stuck .mark { color: var(--ink); }
      /* A logo replaces the wordmark when the shop has supplied a file. Height is
         capped rather than width, so a wide wordmark and a square badge both sit on
         the same baseline. The nav sits over a dark hero before it sticks, so a
         dark-on-transparent logo needs `logoOnDark` too — otherwise it vanishes. */
      .mark { display: inline-flex; align-items: center; gap: 9px; min-width: 0; }
      /* 42px is the size inside the white pill, where the logo is boxed in and
         needs the presence. Over the hero there is no pill to hold it, the
         wordmark next to it is white on a dark photo, and the same 42px reads
         oversized — so the unstuck state runs smaller and grows as it sticks. */
      .mark img {
        height: 36px; width: auto; display: block; flex: none;
        transition: height 0.4s var(--ease-out);
      }
      .nav.stuck .mark img { height: 42px; }
      .mark span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      @media (max-width: 520px) {
        .mark { gap: 7px; }
        .mark img { height: 30px; }
        .nav.stuck .mark img { height: 34px; }
      }

      .nav-links { display: none; align-items: center; gap: 4px; }
      .nav-links a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 100px;
        color: rgba(255, 255, 255, 0.78);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        transition: color 0.3s var(--ease-out), background 0.3s var(--ease-out);
      }
      .nav-links a:hover { color: #fff; background: rgba(255, 255, 255, 0.12); }
      .nav-links a svg { opacity: 0.65; transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out); }
      .nav-links a:hover svg { opacity: 1; transform: translateY(-1px); }

      .nav.stuck .nav-links a { color: var(--ink-mid); }
      .nav.stuck .nav-links a:hover { color: var(--ink); background: rgba(14, 14, 16, 0.05); }

      .nav-cta { display: none; }
      /* No phone means no .nav-tel, so the pill needs another action on mobile or
         it's just a wordmark in an empty capsule. A language flag counts as that
         action — forcing the CTA in as well crowded the pill and truncated the
         shop name. */
      .nav.no-tel:not(.has-lang) .nav-cta { display: inline-flex; }
      .nav-tel { padding: 10px; aspect-ratio: 1; }
      @media (min-width: 940px) {
        .nav-links, .nav-cta { display: inline-flex; }
        .nav-tel { display: none; }
      }

      /* ---------- mobile dock ---------- */
      .dock {
        position: fixed;
        bottom: 0; left: 0; right: 0;
        z-index: 90;
        display: flex;
        gap: 6px;
        margin: 10px;
        margin-bottom: calc(10px + env(safe-area-inset-bottom));
        padding: 7px;
        background: rgba(255, 255, 255, 0.84);
        backdrop-filter: saturate(180%) blur(18px);
        border: 1px solid var(--line);
        border-radius: 100px;
        box-shadow: inset 0 1px 0 #fff, var(--sh-3);
      }
      .dock a {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 13px 4px;
        border-radius: 100px;
        color: var(--ink-mid);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 550;
      }
      .dock a svg { opacity: 0.75; }
      /* needs `a.dock-cta` — plain `.dock-cta` loses to `.dock a` and the
         label renders black-on-black */
      .dock a.dock-cta {
        flex: 1.4 1 0;
        background: var(--brand);
        color: var(--brand-ink);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.24),
          inset 0 -1px 0 rgba(0, 0, 0, 0.28),
          0 2px 5px rgba(var(--brand-rgb), 0.3);
      }
      .dock a.dock-cta svg { opacity: 0.95; }
      .dock a.dock-cta:active { box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5); }
      @media (min-width: 900px) { .dock { display: none; } }
    </style>

    <script>
      // stagger + rise reveals
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -50px 0px' }
      );
      document.querySelectorAll('.rise, .stagger').forEach((el) => io.observe(el));

      // nav condenses once you're past the hero
      const nav = document.getElementById('nav');
      const onScroll = () => nav.classList.toggle('stuck', window.scrollY > 80);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
    </script>

  </body>
</html>
