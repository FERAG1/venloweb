---
// The real WhatsApp glyph. Separate from Icon.astro because that component is a
// stroke set (fill:none, stroke:currentColor) and this is a filled brand mark —
// same reason Google.astro and Flag.astro stand on their own.
// Inherits currentColor so it works on both the green button and a dark bar.
const { size = 18, class: cls = '' } = Astro.props;
---

