---
import Icon from './Icon.astro';
import Google from './Google.astro';
import Flag from './Flag.astro';
import { UI, fmt } from '../i18n/ui.js';
import { pathFor } from '../lib/shops.js';

// The homepage body, factored out so /  and /de/ render the exact same markup
// with a different `shop` + `T`. Nothing here reads shop.json directly — the
// caller passes an already-localised shop.
const { shop, lang, T, langs = ['nl'] } = Astro.props;

const a = shop.address;
// If the shop already runs Salonized/Booksy, send them there instead and the
// built-in flow just doesn't get linked.
const B = pathFor(shop.slug, lang);
const book = shop.booking || `${B}/boeken`;
// only open a new tab for a real external booking URL — never for the #anchor
const bookAttrs = shop.booking ? { target: '_blank', rel: 'noopener' } : {};
// null when we haven't verified the number — every call button then hides itself.
const tel = shop.phone ? `tel:${shop.phone.replace(/\s/g, '')}` : null;
const addrLine = [a.street, a.postcode && a.city ? `${a.postcode} ${a.city}` : a.city].filter(Boolean).join(' · ');
const shortAddr = [a.street, a.city].filter(Boolean).join(' · ');
// Deep-link each price row into the wizard with that service already chosen, so
// browsing → booking doesn't make you pick it twice. Only for the built-in flow;
// an external booking URL has no idea what ?dienst= means. The slug is always the
// Dutch one (see lib/shop.js), so it resolves on both language versions.
const svcHref = (s) => (shop.booking ? book : `${B}/boeken?dienst=${s.slug}`);
const marquee = [...shop.marquee, ...shop.marquee];
const initial = (n) => n.trim()[0].toUpperCase();

// Unsplash resizes on the fly, so srcset costs nothing and stops a phone
// pulling a 1800px hero. sizes tells the browser which width it actually needs.
const setAt = (url, widths) =>
  widths.map((w) => `${url.replace(/w=\d+/, `w=${w}`)} ${w}w`).join(', ');
---

  <!-- ============================== HERO ============================== -->
  <header class="hero" id="top">
    <div class="hero-frame">
      <img
        src={shop.hero}
        srcset={setAt(shop.hero, [640, 960, 1280, 1800])}
        sizes="100vw"
        alt={fmt(T.altInterior, { n: shop.name })}
        fetchpriority="high"
      />
      <div class="veil"></div>

      <div class="hero-copy">
        <div class="hero-inner">
          {shortAddr && <span class="hero-loc"><Icon name="pin" size={13} stroke={2} />{shortAddr}</span>}
          <h1>{shop.name}</h1>
          <p>{shop.tagline}</p>
          <div class="hero-btns">
            <a class="btn btn-lg btn-light" href={book} {...bookAttrs}>
              <Icon name="calendar" size={17} />{T.heroBook}
            </a>
            {tel && <a class="btn btn-lg hero-tel" href={tel}><Icon name="phone" size={17} />{T.heroCallNow}</a>}
          </div>
          <span class="hero-micro"><Icon name="check" size={13} stroke={2.4} />{T.heroWalkIn}</span>
        </div>
      </div>
    </div>

    <!-- overlapping card: the depth cue, and the social proof, above the fold -->
    <div class="wrap">
      <div class="hero-card">
        {shop.rating && (
          <div class="hc-rating">
            <Google type="g" size={22} />
            <div>
              <div class="hc-score">
                <strong>{shop.rating.score}</strong>
                <Google type="stars" size={15} score={Number(shop.rating.score)} />
              </div>
              <span>{shop.rating.count} {T.googleReviewsCount}</span>
            </div>
          </div>
        )}

        <!-- Status is computed in the browser, not baked in: this is a static
             site, so a hardcoded "Vandaag open tot 18:00" is wrong tomorrow and a
             lie on days they're closed. shop.todayLine is left blank on purpose and only used for exceptional
             notices like a holiday closure. -->
        <div class="hc-open" id="hcOpen">
          <span class="pulse"></span>
          <div>
            <strong id="hcToday">{shop.todayLine}</strong>
            <span>{T.heroSlotsToday}</span>
          </div>
        </div>

        <a class="btn hc-btn" href={book} {...bookAttrs}>
          {T.ctaBook} <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </header>

  <!-- ============================== MARQUEE ============================== -->
  <div class="marquee" id="marquee">
    <div class="marquee-track" id="mqTrack">
      {marquee.map((m) => (
        <span data-img={setAt(m.img, [500])}>{m.label}<i></i></span>
      ))}
    </div>

    <!-- cursor-following preview; desktop only, purely decorative -->
    <div class="peek" id="peek" aria-hidden="true">
      {/* no src attribute — src="" makes some browsers re-request the page URL
          and registers as a broken image. JS sets it on first hover. */}
      <div class="peek-in"><img id="peekImg" alt="" /></div>
    </div>
  </div>

  <!-- ============================== WHY ============================== -->
  <section class="why-sec">
    <div class="wrap why-grid">
      <div class="rise why-intro">
        <p class="eyebrow">{T.eyebrowWhy}</p>
        <h2>{T.whyHeadA}<br />{T.whyHeadB}</h2>
        <p class="lede">{shop.intro}</p>
      </div>

      <div class="why stagger">
        {shop.why.map((w) => (
          <div class="why-item">
            <span class="why-ico"><Icon name={w.icon} size={19} /></span>
            <div>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== SERVICES ============================== -->
  <section id="prijzen" class="band">
    <div class="wrap">
      <div class="head rise">
        <div>
          <p class="eyebrow">{T.eyebrowPrices}</p>
          <h2>{T.pricesTitle}</h2>
        </div>
        <a class="btn head-btn" href={book} {...bookAttrs}>
          {T.ctaBook} <Icon name="arrow" size={16} />
        </a>
      </div>

      <div class="svc card stagger">
        {shop.services.map((s, i) => (
          <a class="svc-row" href={svcHref(s)} {...bookAttrs}>
            <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="svc-main">
              <strong>{s.name}</strong>
              <em>{s.desc}</em>
            </span>
            <span class="svc-time"><Icon name="clock" size={13} stroke={2} />{s.time}</span>
            <span class="svc-price">€{s.price}</span>
            <span class="svc-go"><Icon name="arrow" size={15} stroke={2} /></span>
          </a>
        ))}
      </div>
      <p class="svc-note"><Icon name="check" size={14} stroke={2.4} />{T.pricesNote}</p>
    </div>
  </section>

  <!-- ============================== GALLERY ============================== -->
  <section id="werk">
    <div class="wrap">
      <div class="head rise">
        <div>
          <p class="eyebrow">{T.eyebrowWork}</p>
          <h2>{T.workTitle}</h2>
        </div>
      </div>
      <div class="grid stagger">
        {shop.gallery.map((src, i) => (
          <div class={`media cell c${i}`}>
            <img src={src} srcset={setAt(src, [400, 640, 900, 1200])}
              sizes="(min-width: 820px) 25vw, 50vw"
              alt={fmt(T.altCut, { n: shop.name })} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== GOOGLE REVIEWS ==============================
       Only rendered when there are real reviews to show. A new shop starts with
       reviews: [] and the whole section disappears — never invent testimonials
       to fill it. -->
  {shop.reviews?.length > 0 && (
  <section id="reviews" class="band">
    <div class="wrap rev-grid">
      <aside class="rev-side rise">
        <p class="eyebrow">{T.eyebrowReviews}</p>
        <h2>{T.reviewsTitleA}<br />{T.reviewsTitleB}</h2>

        <div class="rev-sum card">
          <div class="rs-top">
            <Google type="g" size={20} />
            <span>{T.googleReviews}</span>
          </div>
          <div class="rs-score">
            <strong>{shop.rating?.score}</strong>
            <div>
              <Google type="stars" size={17} score={Number(shop.rating?.score ?? 0)} />
              <span>{fmt(T.basedOn, { n: shop.rating?.count ?? 0 })}</span>
            </div>
          </div>
          <a class="btn btn-light btn-sm rs-btn" href={a.maps || "#"} target="_blank" rel="noopener">
            Bekijk alle reviews <Icon name="arrow" size={14} />
          </a>
        </div>
      </aside>

      <div class="rev-list stagger">
        {shop.reviews.map((r) => (
          <figure class="rev card">
            <header>
              <span class="av" style={`background:${r.tone}`}>{initial(r.author)}</span>
              <div class="av-meta">
                <strong>{r.author}</strong>
                <span>{r.when}</span>
              </div>
              <Google type="g" size={16} />
            </header>
            {/* No score = we never verified the star count. Omit the row rather
                than render a default, which would silently invent a rating. */}
            {r.score != null && (
              <div class="rev-stars"><Google type="stars" size={17} score={r.score} /></div>
            )}
            <blockquote>{r.text}</blockquote>
          </figure>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- ============================== TEAM ============================== -->
  <section>
    <div class="wrap">
      <div class="head rise">
        <div>
          <p class="eyebrow">{T.eyebrowTeam}</p>
          <h2>{T.teamTitle}</h2>
        </div>
      </div>
      <div class="team stagger">
        {shop.team.map((m) => (
          <div class="member">
            <div class="media m-portrait"><img src={m.photo} srcset={setAt(m.photo, [300, 480, 800])}
                sizes="(min-width: 940px) 25vw, 45vw"
                alt={m.name} loading="lazy" /></div>
            <h3>{m.name}</h3>
            <p>{m.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section id="faq">
    <div class="wrap faq-grid">
      <div class="rise faq-intro">
        <p class="eyebrow">{T.eyebrowFaq}</p>
        <h2>{T.faqHeadA}<br />{T.faqHeadB}</h2>
        <p class="lede">{T.faqFoot}</p>
        {tel && (
          <a class="btn btn-light" href={tel} style="margin-top:26px">
            <Icon name="phone" size={16} />{shop.phone}
          </a>
        )}
      </div>

      <div class="faq stagger">
        {shop.faq.map((f, i) => (
          <details class="faq-item" name="faq" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="faq-ico"><Icon name="arrow" size={16} stroke={2} /></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================== VISIT ============================== -->
  <section id="bezoek" class="band">
    <div class="wrap visit">
      <div class="media visit-photo rise">
        <img src={shop.storefront} srcset={setAt(shop.storefront, [480, 800, 1200])}
             sizes="(min-width: 940px) 50vw, 100vw"
             alt={`${shop.name} in ${a.city}`} loading="lazy" />
      </div>

      <div class="rise">
        <p class="eyebrow">{T.eyebrowVisit}</p>
        <h2>{T.visitHours}</h2>
        <ul class="hours card">
          {shop.hours.map((h) => (
            <li class={h.time === 'Gesloten' ? 'closed' : ''}>
              <span>{h.day}</span><span>{h.time}</span>
            </li>
          ))}
        </ul>
        {addrLine && (
          <div class="addr">
            <Icon name="pin" size={17} />
            <address>{addrLine}</address>
          </div>
        )}
        <div class="visit-btns">
          {a.maps && <a class="btn" href={a.maps} target="_blank" rel="noopener"><Icon name="pin" size={16} />{T.dockRoute}</a>}
          {tel && <a class="btn btn-light" href={tel}><Icon name="phone" size={16} />{shop.phone}</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== FINAL CTA ============================== -->
  <section class="cta-sec">
    <div class="cta">
      <img src={shop.ctaImage} srcset={setAt(shop.ctaImage, [640, 1100, 1800])}
           sizes="100vw" alt="" loading="lazy" />
      <div class="cta-veil"></div>
      <div class="wrap cta-in rise">
        <p class="eyebrow cta-eye">{T.eyebrowCta}</p>
        <h2>{T.ctaTitleA}<br />{T.ctaTitleB}</h2>
        <p>{T.ctaSub}</p>
        <div class="cta-btns">
          <a class="btn btn-lg btn-light" href={book} {...bookAttrs}>
            <Icon name="calendar" size={17} />{T.ctaBook}
          </a>
          {tel && <a class="btn btn-lg cta-tel" href={tel}><Icon name="phone" size={17} />{shop.phone}</a>}
        </div>
        {shortAddr && <span class="cta-micro"><Icon name="check" size={13} stroke={2.4} />{shortAddr}</span>}
      </div>
    </div>
  </section>

  <footer class="ft">
    <div class="wrap ft-in">
      <div class="ft-brand">
        <span class="ft-mark">
          {shop.logo && <img src={shop.logo} alt="" height="38" />}
          <span>{shop.name}</span>
        </span>
        <p class="ft-tag">{shop.tagline}</p>
        {addrLine && (
          <p class="ft-line"><Icon name="pin" size={14} stroke={2} />{addrLine}</p>
        )}
        {tel && (
          <a class="ft-line ft-link" href={tel}><Icon name="phone" size={14} stroke={2} />{shop.phone}</a>
        )}
      </div>

      <nav class="ft-col" aria-label={T.navPrices}>
        <h3>{T.eyebrowPrices}</h3>
        <a href={`${B}/#prijzen`}>{T.navPrices}</a>
        <a href={`${B}/#werk`}>{T.navWork}</a>
        {shop.reviews?.length > 0 && <a href={`${B}/#reviews`}>{T.navReviews}</a>}
        <a href={`${B}/#bezoek`}>{T.navVisit}</a>
        <a href={book} {...bookAttrs}>{T.navBook}</a>
      </nav>

      <div class="ft-col ft-hours">
        <h3>{T.visitHours}</h3>
        <ul>
          {shop.hours.map((h, i) => (
            <li data-d={i}><span>{h.day}</span><b>{h.time}</b></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="ft-bar">
      <div class="wrap ft-bar-in">
        <span>© {new Date().getFullYear()} {shop.name}</span>
        {langs.length > 1 && (
          <nav class="langs" aria-label="Taal / Sprache">
            {langs.map((l) => (
              <a href={`${pathFor(shop.slug, l)}/`} hreflang={l} aria-current={l === lang ? 'true' : undefined}>
                <Flag code={l} size={15} />
                <span>{UI[l].langName}</span>
              </a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </footer>

<script type="application/json" id="hoursData" set:html={JSON.stringify({
  hours: shop.hours.map((h) => h.time),
  days: shop.hours.map((h) => h.day),
  override: shop.todayLine || null,
  t: {
    openNowUntil: T.openNowUntil, opensTodayAt: T.opensTodayAt,
    closedToday: T.closedToday, opensAgain: T.opensAgain,
  },
})} />

<script>
  /* ---------- live open/closed status ---------- */
  {
    const el = document.getElementById('hcToday');
    const box = document.getElementById('hcOpen');
    const raw = document.getElementById('hoursData');
    if (el && raw) {
      const d = JSON.parse(raw.textContent);
      const fmt = (str, v = {}) => String(str).replace(/\{(\w+)\}/g, (m, k) => v[k] ?? '');
      const parse = (t) => {
        const m = String(t).match(/(\d{1,2}):(\d{2})\s*[–-]\s*(\d{1,2}):(\d{2})/);
        return m ? [+m[1] * 60 + +m[2], +m[3] * 60 + +m[4]] : null;
      };
      const now = new Date();
      // hours[] is Monday-first; getDay() is Sunday-first
      const idx = (now.getDay() + 6) % 7;
      const mins = now.getHours() * 60 + now.getMinutes();
      const hm = (m) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
      const today = parse(d.hours[idx]);
      let text, open = false;

      if (d.override) {
        text = d.override; open = true;            // hand-written line wins
      } else if (today && mins < today[1]) {
        open = mins >= today[0];
        text = open ? fmt(d.t.openNowUntil, { t: hm(today[1]) })
                    : fmt(d.t.opensTodayAt, { t: hm(today[0]) });
      } else {
        // closed today, or already shut — point at the next open day
        let next = null;
        for (let i = 1; i <= 7; i++) {
          const j = (idx + i) % 7;
          if (parse(d.hours[j])) { next = d.days[j]; break; }
        }
        text = next ? fmt(d.t.opensAgain, { d: next.toLowerCase() }) : d.t.closedToday;
      }
      el.textContent = text;
      box.classList.toggle('shut', !open);
      // highlight today in the footer hours — the reason anyone scrolls down
      document.querySelector(`.ft-hours li[data-d="${idx}"]`)?.classList.add('is-today');
    }
  }

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const marquee = document.getElementById('marquee');
  const track = document.getElementById('mqTrack');
  const peek = document.getElementById('peek');
  const peekImg = document.getElementById('peekImg');

  if (marquee && track && !reduce) {
    // Take the marquee off the CSS animation and drive it by hand. Changing
    // animation-duration on hover makes it visibly jump; a rAF loop lets the
    // speed ease between values instead.
    track.style.animation = 'none';

    const FAST = 58;   // px per second
    const SLOW = 9;
    let speed = FAST, target = FAST;
    let offset = 0, last = performance.now();
    let half = track.scrollWidth / 2;   // content is duplicated
    addEventListener('resize', () => { half = track.scrollWidth / 2; });

    // cursor follow, lerped so the card trails slightly behind the pointer
    let mx = 0, my = 0, px = 0, py = 0, lastMx = 0;

    const frame = (now) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      speed += (target - speed) * Math.min(dt * 6, 1);
      offset = (offset + speed * dt) % half;
      track.style.transform = `translateX(${-offset}px)`;

      px += (mx - px) * Math.min(dt * 12, 1);
      py += (my - py) * Math.min(dt * 12, 1);
      peek.style.transform = `translate3d(${px}px, ${py}px, 0)`;

      // tilt with horizontal travel — leans into the direction you're moving
      const tilt = Math.max(-16, Math.min(16, -6 + (mx - lastMx) * 0.6));
      peek.style.setProperty('--tilt', `${tilt}deg`);
      lastMx = mx;

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    marquee.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      mx = e.clientX;
      my = e.clientY;
      if (!peek.classList.contains('on')) { px = mx; py = my; }
      // flip above the cursor when the card would fall off the bottom
      peek.classList.toggle('up', my + 32 + 229 > innerHeight - 12);

      const word = e.target.closest('span[data-img]');
      marquee.querySelectorAll('span.lit').forEach((s) => s.classList.remove('lit'));

      if (word) {
        word.classList.add('lit');
        const src = word.dataset.img;
        if (peekImg.getAttribute('src') !== src) peekImg.src = src;
        peek.classList.add('on');
        marquee.classList.add('peeking');
        target = SLOW;
      } else {
        peek.classList.remove('on');
        marquee.classList.remove('peeking');
        target = FAST;
      }
    });

    marquee.addEventListener('pointerleave', () => {
      peek.classList.remove('on');
      marquee.classList.remove('peeking');
      marquee.querySelectorAll('span.lit').forEach((s) => s.classList.remove('lit'));
      target = FAST;
    });
  }
</script>

<style>
  /* ------------------------------ hero ------------------------------ */
  .hero-frame {
    position: relative;
    height: 92svh;
    min-height: 580px;
    margin: var(--frame);
    margin-bottom: 0;
    border-radius: var(--r-xl);
    overflow: hidden;
    box-shadow: var(--sh-4);
  }
  .hero-frame > img {
    width: 100%; height: 100%; object-fit: cover;
    animation: heroIn 1.6s var(--ease-out) both;
  }
  @keyframes heroIn { from { transform: scale(1.08); } to { transform: scale(1); } }
  .veil { position: absolute; inset: 0; background: rgba(9, 9, 11, 0.5); }

  .hero-copy {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding-bottom: 96px;
    color: #fff;
  }
  /* Puts the hero copy on the same column as every section below it.
     Once max-width applies, the frame's own margin cancels out (it's centred),
     so this matches .wrap exactly. Below that width the frame inset has to be
     subtracted, or the hero sits --frame further in than the rest of the page. */
  .hero-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 calc(var(--gut) - var(--frame));
  }
  @media (min-width: 1160px) {
    .hero-inner { padding: 0 var(--gut); }
  }
  .hero-loc {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }
  .hero-copy h1 { margin: 18px 0 16px; }
  .hero-copy > p { font-size: 1.14rem; color: rgba(255, 255, 255, 0.88); max-width: 32ch; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 10px; margin: 30px 0 18px; }
  /* full-width on phones — two content-sized pills stacked read as ragged */
  .hero-btns .btn { width: 100%; }
  @media (min-width: 540px) { .hero-btns .btn { width: auto; } }
  .hero-tel {
    background: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.24), 0 2px 8px rgba(0, 0, 0, 0.22);
  }
  .hero-tel:hover { background: rgba(255, 255, 255, 0.2); }
  .hero-micro {
    display: inline-flex; align-items: center; gap: 7px;
    font-size: 0.84rem; color: rgba(255, 255, 255, 0.72);
  }
  .hero-micro svg { color: #6ee7a0; }

  /* overlap card */
  .hero-card {
    position: relative; z-index: 5;
    display: grid; gap: var(--s3);
    margin-top: -52px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: inset 0 1px 0 #fff, var(--sh-4);
  }
  .hc-rating, .hc-open { display: flex; align-items: center; gap: 13px; }
  /* green dot means open — don't pulse at someone on a Sunday night */
  .hc-open.shut .pulse { background: var(--ink-soft); animation: none; box-shadow: none; }
  .hc-score { display: flex; align-items: center; gap: 9px; }
  .hc-score strong { font-size: 1.32rem; font-weight: 650; letter-spacing: -0.03em; }
