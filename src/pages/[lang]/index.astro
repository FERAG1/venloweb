---
import Base from '../../layouts/Base.astro';
import HomeBody from '../../components/HomeBody.astro';
import shopData from '../../data/shop.json';
import { localizedShop, availableLangs } from '../../lib/shop.js';
import { t } from '../../i18n/ui.js';

// Dynamic rather than a literal /de/ folder on purpose: a shop that hasn't paid
// for the German add-on has no `de` block, so this route emits NOTHING. Otherwise
// every Dutch-only site would ship an orphan /de/ page serving Dutch copy under
// lang="de" — duplicate content, and Google would notice.
export function getStaticPaths() {
  return availableLangs(shopData)
    .filter((l) => l !== 'nl') // Dutch is the site root, not a prefixed route
    .map((l) => ({ params: { lang: l } }));
}

const lang = Astro.params.lang;
const shop = localizedShop(shopData, lang);
const langs = availableLangs(shopData);
---

<Base shop={shop} lang={lang} langs={langs}>
  <HomeBody shop={shop} lang={lang} langs={langs} T={t(lang)} />
</Base>
