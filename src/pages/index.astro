---
import '../styles/theme.css';

// Deliberately blank-ish. The demo launcher used to live here, which meant any
// owner who trimmed a link back to the bare domain landed on a list of his
// competitors. Now the root says nothing: no shop names, no links, no nav.
// The launcher moved to an unguessable path — see src/pages/kiosk-*/index.astro.
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Venloweb</title>
    <meta name="theme-color" content="#f1f0ec" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <main class="holding">
      <p class="eyebrow">Venloweb</p>
      <h1>Websites voor<br />lokale zaken.</h1>
      <p class="lede">Venlo &amp; omstreken.</p>
    </main>

    <style>
      body { background: var(--bg); color: var(--ink); }
      .holding {
        min-height: 100svh;
        display: flex; flex-direction: column; justify-content: center;
        max-width: var(--max); margin: 0 auto; padding: 0 var(--gut);
      }
      .holding h1 { font-size: clamp(2.6rem, 9vw, 5rem); }
      .holding .lede { margin-top: var(--s3); }
    </style>
  </body>
</html>
