---
import '../../styles/theme.css';
import Icon from '../../components/Icon.astro';
import Flag from '../../components/Flag.astro';
import { allShops, pathFor } from '../../lib/shops.js';
import { availableLangs } from '../../lib/shop.js';

// INTERNAL launcher, deliberately NOT at "/". It lists every demo we've built, so
// an owner who trims the URL back to the domain must not land here and find nine
// of his competitors. The path is unguessable, noindex, and robots-disallowed.
//
// That is obscurity, not authentication — a static site has no server to check a
// password against, and any client-side gate is bypassable by viewing source. It
// is enough for "don't stumble onto it", not for "this is secret".
const shops = allShops.map(({ slug, data }) => ({
  slug,
  name: data.name,
  city: data.address?.city ?? '',
  street: data.address?.street ?? '',
  langs: availableLangs(data),
  photo: data.storefront || data.hero || '',
  // the template ships +31 77 000 0000; a real shop won't have it
  live: !String(data.phone || '').includes('000 0000'),
}));
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Demo's — Venloweb</title>
    <meta name="theme-color" content="#f1f0ec" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <main class="wrap lp">
      <header class="lp-head">
        <p class="eyebrow">Venloweb</p>
        <h1>Demo's</h1>
        <p class="lede">
          Kies een zaak om de site te openen. {shops.length} {shops.length === 1 ? 'demo' : "demo's"} klaar.
        </p>
        <p class="lp-warn">
          <Icon name="spark" size={15} stroke={2} />
          Interne pagina — laat deze lijst niet aan een eigenaar zien, hij staat vol concurrenten.
        </p>
      </header>

      <ul class="lp-grid">
        {shops.map((s) => (
          <li class="lp-card card">
            <a class="lp-main" href={`${pathFor(s.slug)}/`}>
              {s.photo && <span class="lp-thumb media"><img src={s.photo} alt="" loading="lazy" /></span>}
              <span class="lp-txt">
                <strong>{s.name}</strong>
                <em>{[s.street, s.city].filter(Boolean).join(' · ') || '—'}</em>
              </span>
              <span class="lp-go"><Icon name="arrow" size={16} stroke={2} /></span>
            </a>

            <div class="lp-foot">
              <span class="lp-slug">/{s.slug}</span>
              {!s.live && <span class="lp-todo">placeholder data</span>}
              <span class="lp-langs">
                {s.langs.map((l) => (
                  <a href={`${pathFor(s.slug, l)}/`} title={l.toUpperCase()}>
                    <Flag code={l} size={15} />
                  </a>
                ))}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </main>

    <style>
      body { background: var(--bg); color: var(--ink); }
      .lp { padding: clamp(48px, 9vw, 104px) var(--gut); }
      .lp-head { margin-bottom: var(--s5); }
      .lp-head h1 { font-size: clamp(2.6rem, 8vw, 4.4rem); }
      .lp-warn {
        display: inline-flex; align-items: center; gap: 8px;
        margin-top: var(--s3); padding: 9px 15px 9px 12px;
        border-radius: 100px; background: rgba(161, 124, 66, 0.1);
        color: #6f5124; font-size: 0.85rem; font-weight: 550;
      }
      .lp-warn svg { flex: none; }

      .lp-grid {
        list-style: none; display: grid; gap: var(--s3);
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      }
      .lp-card { overflow: hidden; }
      .lp-main {
        display: flex; align-items: center; gap: 14px;
        padding: 14px; text-decoration: none; color: inherit;
        transition: background 0.2s var(--ease-out);
      }
      .lp-main:hover { background: var(--surface-2); }
      .lp-thumb { width: 58px; height: 58px; flex: none; border-radius: var(--r-sm); overflow: hidden; }
      .lp-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .lp-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
      .lp-txt strong { font-weight: 600; letter-spacing: -0.02em; }
      .lp-txt em {
        font-style: normal; font-size: 0.85rem; color: var(--ink-soft);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      }
      .lp-go { flex: none; color: var(--ink-soft); }
      .lp-main:hover .lp-go { color: var(--ink); }

      .lp-foot {
        display: flex; align-items: center; gap: 10px;
        padding: 10px 14px; border-top: 1px solid var(--line);
        background: var(--surface-2); font-size: 0.78rem; color: var(--ink-soft);
      }
      .lp-slug { font-variant-numeric: tabular-nums; }
      .lp-langs { display: flex; gap: 5px; margin-left: auto; }
      .lp-langs a { display: block; line-height: 0; opacity: 0.75; transition: opacity 0.2s var(--ease-out); }
      .lp-langs a:hover { opacity: 1; }
      .lp-todo {
        padding: 2px 8px; border-radius: 100px;
        background: rgba(161, 124, 66, 0.14); color: #6f5124; font-weight: 550;
      }
    </style>
  </body>
</html>
